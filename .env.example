# Public site URL used for canonical URLs, sitemap and structured data.
# Change this when you move to a custom domain.
NEXT_PUBLIC_SITE_URL=https://qyvora.vercel.app

# Contact form delivery through Web3Forms (https://web3forms.com).
# Optional: the default access key lives in lib/contact.ts. Set this only to use
# a different key. Inquiries are emailed to the inbox the key was created for.
NEXT_PUBLIC_WEB3FORMS_KEY=
